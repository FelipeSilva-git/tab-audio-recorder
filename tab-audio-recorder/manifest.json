{
  "manifest_version": 3,
  "name": "Gravador de Áudio de Aba",
  "version": "1.0",
  "description": "Grava o áudio de apenas uma aba específica do navegador.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
